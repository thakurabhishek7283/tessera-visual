    "path": ["packages/annotator/dist/elements/index.js"],
    "limit": "38 kB",
    "gzip": true,
    "ignore": [
      "@tessera/core",
      "@tessera/elements",
      "@tessera/storage",
      "@tessera/transport",
      "@tessera/protocol",
      "@tessera/react",
      "lit",
