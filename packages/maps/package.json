{
  "name": "@tessera-kit/maps",
  "version": "0.1.0",
  "description": "Maps kit for Tessera: MapLibre map with clustering, popups and a form-associated location picker, no API key needed",
  "license": "MIT",
  "author": "Abhishek Thakur",
  "type": "module",
  "sideEffects": [
    "./dist/elements/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@lit/context": "^1.1.0",
    "lit": "^3.3.0",
    "zod": "^4.1.0",
    "maplibre-gl": "^6.11.2"
  },
  "peerDependencies": {
    "@tessera-kit/core": "^0.1.0",
    "@tessera-kit/elements": "^0.1.0",
    "@tessera-kit/react": "^0.1.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tessera-kit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/sync-maplibre-css.mjs && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "sync-css": "node scripts/sync-maplibre-css.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tessera-internal/react-wrap": "workspace:*",
    "@tessera-internal/test-utils": "workspace:*",
    "@tessera-kit/core": "^0.1.0",
    "@tessera-kit/elements": "^0.1.0",
    "@tessera-kit/react": "^0.1.0",
    "@tessera-kit/storage": "^0.1.0",
    "@tessera-kit/testing": "^0.1.0",
    "@tessera-kit/transport": "^0.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.63.0",
    "react": "^19",
    "react-dom": "^19.3.0"
  }
}
